# Angular's tooling expects a flat node_modules layout. With node-linker=hoisted
# pnpm produces the same structure npm would, so first-party imports resolve
# without surprises. shamefully-hoist is a no-op when using the hoisted linker
# and is intentionally not set.
node-linker=hoisted
# Some transitive deps (e.g. @swimlane/ngx-charts) declare older Angular peer
# ranges. We satisfy them via pnpm.peerDependencyRules + pnpm.overrides in
# package.json and don't want install to fail on the mismatch.
strict-peer-dependencies=false
