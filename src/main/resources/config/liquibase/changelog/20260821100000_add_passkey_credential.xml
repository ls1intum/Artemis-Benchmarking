<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Store a WebAuthn passkey credential per Artemis user.

      Artemis can require a passkey for administrator features
      (artemis.user-management.passkey.require-for-administrator-features). Where that is on, a password
      login authenticates but every admin endpoint answers 403, because the check reads the
      authentication method off the JWT. The simulation therefore needs to be able to log in with a
      passkey, which means holding the credential's private key itself: a passkey created in a browser
      is unusable here, since its key never leaves the platform authenticator.

      `passkey_cose_key` is as sensitive as the existing `password` column. The tool already documents
      that its database must only hold test credentials; this does not change that, but it raises the
      stakes, so the column is deliberately named for what it is.
    -->
    <changeSet id="20260821100000-add-passkey-credential" author="benchmarking">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="artemis_user" columnName="passkey_credential_id"/>
            </not>
        </preConditions>

        <addColumn tableName="artemis_user">
            <column name="passkey_credential_id" type="varchar(255)"/>
            <column name="passkey_cose_key" type="varchar(2048)"/>
            <column name="passkey_user_handle" type="varchar(255)"/>
            <column name="passkey_signature_count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
