{
  "name": "artemis-benchmarking",
  "version": "0.4.3",
  "private": true,
  "description": "Artemis Benchmarking",
  "license": "MIT",
  "author": {
    "name": "Stephan Krusche",
    "email": "krusche@tum.de",
    "url": "https://aet.cit.tum.de/krusche"
  },
  "scripts": {
    "prebuild": "node prebuild.mjs",
    "build": "pnpm run webapp:prod",
    "cleanup": "rimraf build/",
    "compile:ts:tests": "pnpm run prebuild && tsc --project tsconfig.spec.json",
    "postinstall": "husky",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "prettier:check": "prettier --check \"{,src/**/,.blueprint/**/}*.{md,json,yml,html,cjs,mjs,js,ts,tsx,css,scss,java}\"",
    "prettier:format": "prettier --write \"{,src/**/,.blueprint/**/}*.{md,json,yml,html,cjs,mjs,js,ts,tsx,css,scss,java}\"",
    "serve": "pnpm run start",
    "services:up": "docker compose -f src/main/docker/services.yml up --wait",
    "start": "pnpm run prebuild --develop && ng serve --hmr",
    "start-tls": "pnpm run webapp:dev-ssl",
    "pretest": "pnpm run lint",
    "test": "pnpm run prebuild && ng test",
    "test:watch": "pnpm run prebuild && pnpm run test --watch",
    "update": "ncu -i --format group",
    "webapp:build": "pnpm run prebuild --develop && ng build --configuration development",
    "webapp:dev": "pnpm run prebuild --develop && ng serve",
    "webapp:prod": "pnpm run prebuild && NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration production"
  },
  "config": {
    "default_environment": "prod"
  },
  "dependencies": {
    "@angular/animations": "21.2.13",
    "@angular/cdk": "21.2.11",
    "@angular/common": "21.2.13",
    "@angular/compiler": "21.2.13",
    "@angular/core": "21.2.13",
    "@angular/forms": "21.2.13",
    "@angular/localize": "21.2.13",
    "@angular/platform-browser": "21.2.13",
    "@angular/platform-browser-dynamic": "21.2.13",
    "@angular/router": "21.2.13",
    "@angular/service-worker": "21.2.13",
    "@fortawesome/angular-fontawesome": "4.0.0",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "@stomp/rx-stomp": "2.4.0",
    "@swimlane/ngx-charts": "23.1.0",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.20",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.11",
    "@angular/build": "21.2.11",
    "@angular/cli": "21.2.11",
    "@angular/compiler-cli": "21.2.13",
    "@eslint/js": "10.0.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.1.8",
    "@types/node": "25.8.0",
    "angular-eslint": "21.4.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "prettier-plugin-java": "2.8.1",
    "prettier-plugin-packagejson": "3.0.2",
    "rimraf": "6.1.3",
    "sass": "1.99.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@swimlane/ngx-charts>@angular/animations": "21",
        "@swimlane/ngx-charts>@angular/cdk": "21",
        "@swimlane/ngx-charts>@angular/common": "21",
        "@swimlane/ngx-charts>@angular/core": "21",
        "@swimlane/ngx-charts>@angular/forms": "21",
        "@swimlane/ngx-charts>@angular/platform-browser": "21",
        "@swimlane/ngx-charts>@angular/platform-browser-dynamic": "21"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "@swimlane/ngx-charts>@angular/animations": "^21.2.13",
      "@swimlane/ngx-charts>@angular/cdk": "^21.2.13",
      "@swimlane/ngx-charts>@angular/common": "^21.2.13",
      "@swimlane/ngx-charts>@angular/compiler": "^21.2.13",
      "@swimlane/ngx-charts>@angular/core": "^21.2.13",
      "@swimlane/ngx-charts>@angular/forms": "^21.2.13",
      "@swimlane/ngx-charts>@angular/platform-browser": "^21.2.13",
      "@swimlane/ngx-charts>@angular/platform-browser-dynamic": "^21.2.13",
      "@swimlane/ngx-charts>@angular/router": "^21.2.13",
      "@swimlane/ngx-charts>rxjs": "^7.8.2",
      "braces": "3.0.3",
      "cookie": "1.1.1",
      "debug": "4.4.3",
      "esbuild": "0.27.2",
      "express": "5.2.1",
      "globals": "17.6.0",
      "lodash": "4.17.23",
      "lodash-es": "4.17.23",
      "postcss": "8.5.6",
      "punycode": "2.3.1",
      "rimraf": "6.1.3",
      "tough-cookie": "6.0.0",
      "webpack": "5.104.1",
      "webpack-dev-middleware": "7.4.5",
      "webpack-dev-server": "5.2.3",
      "word-wrap": "1.2.5",
      "ws": "8.19.0",
      "yargs-parser": "22.0.0"
    }
  },
  "cacheDirectories": [
    "node_modules"
  ]
}
